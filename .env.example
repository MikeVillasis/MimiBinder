# Copy to .env.local for local development. Every variable is optional:
# without the Supabase variables the app runs in guest/local-only mode
# (collection stored in this browser's IndexedDB, no sign-in, no sync).

# Supabase project URL (public, used by the browser client for owner sign-in and sync).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (public, safe to expose; row-level security protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SECRET, server only; used by the price-snapshot cron job). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/cron/snapshot; Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
